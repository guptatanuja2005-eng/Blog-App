<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> | Blog Studio</title>
    <link rel="stylesheet" href="/styles/app.css">
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/">Blog Studio</a>
      <nav class="nav">
        <a href="/posts">Posts</a>
        <% if (currentUser) { %>
          <a href="/dashboard">Dashboard</a>
          <form method="post" action="/logout">
            <button type="submit" class="link-button">Logout</button>
          </form>
        <% } else { %>
          <a href="/login">Login</a>
          <a class="nav-action" href="/signup">Signup</a>
        <% } %>
      </nav>
    </header>

    <main>
      <% if (messages.error.length) { %>
        <div class="flash flash-error"><%= messages.error[0] %></div>
      <% } %>
      <% if (messages.success.length) { %>
        <div class="flash flash-success"><%= messages.success[0] %></div>
      <% } %>
